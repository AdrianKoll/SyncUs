# 🔒 ARQUIVOS SENSÍVEIS (NUNCA VERSIONAR!)
.env
.env.*
!.env.example
*.secret
*.key
*.pem
*.crt
id_rsa*

# 🐍 PYTHON / FASTAPI
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
poetry.lock
.venv/
venv/
ENV/
env/

# 🐳 DOCKER
*.log
docker-compose.override.yml
.docker-data/
postgres_data/
pgadmin_data/

# 🗄️ BANCO DE DADOS
*.sqlite
*.sqlite3
*.db
dump.rdb

# 🖼️ FRONT-END
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# ⚙️ EDITORES / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# 📊 TESTES / COBERTURA
.coverage
.coverage.*
.cache
.pytest_cache/
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# 📦 OUTROS
*.bak
*.tmp
*.old