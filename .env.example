# =================================================================
# SyncUs - Modelo de Configuração de Ambiente (.env.example)
# Instruções: Copie este arquivo para um novo chamado '.env' 
# e preencha com seus dados reais. NUNCA suba o '.env' para o Git.
# =================================================================

# 🗄️ CONFIGURAÇÕES DO BANCO DE DADOS (PostgreSQL)
POSTGRES_USER=admin_user
POSTGRES_PASSWORD=insira_uma_senha_segura_aqui
POSTGRES_DB=syncus_db_name

# 🛠️ CONFIGURAÇÕES DO PGADMIN (Interface Web)
PGADMIN_DEFAULT_EMAIL=admin@exemplo.com
PGADMIN_DEFAULT_PASSWORD=senha_acesso_pgadmin

# 🔒 SEGURANÇA DA API (JWT / Autenticação)
# Dica: Gere uma chave segura rodando 'openssl rand -hex 32' no terminal
SECRET_KEY=sua_chave_secreta_super_segura_gerada_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 🌐 AMBIENTE (Opcional)
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
